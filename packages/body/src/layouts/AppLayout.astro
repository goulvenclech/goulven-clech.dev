---
import "$assets/base.css"
import { Font } from "astro:assets"
import { PAGE_SUBTITLE_ID, PAGE_TITLE_ID } from "$src/client/dom"

interface Props {
	title: string
	twin?: string
	description?: string
	subtitle?: string
}

const {
	title,
	twin,
	description = "Personal workout tracker.",
	subtitle,
} = Astro.props

const tabs = [
	{ href: "/", label: "Today" },
	{ href: "/log", label: "Log" },
	{ href: "/stats", label: "Stats" },
	{ href: "/about", label: "About" },
]

const path = Astro.url.pathname
const isCurrent = (href: string) =>
	href === "/" ? path === "/" : path.startsWith(href)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="Goulven Clec'h" />
		<meta name="description" content={description} />
		<!-- Personal tracker: keep it out of search results. -->
		<meta name="robots" content="noindex" />
		{twin && <link rel="alternate" type="text/markdown" href={twin} />}
		<meta
			name="theme-color"
			media="(prefers-color-scheme: light)"
			content="#fafafa"
		/>
		<meta
			name="theme-color"
			media="(prefers-color-scheme: dark)"
			content="#101116"
		/>
		<link rel="icon" href="/favicon.svg" />
		<Font cssVariable="--font-inter" preload />
		<title>{title} – Body</title>
	</head>
	<body>
		<main>
			<header>
				<!-- Glued on purpose: the wordmark runs into the title, BODYSTATS. -->
				<h1>
					<span class="text-primary">Body</span><span
						id={PAGE_TITLE_ID}
						class="italic">{title}</span
					>
				</h1>
				<p
					id={PAGE_SUBTITLE_ID}
					class="text-muted-light dark:text-muted-dark mt-2 text-sm font-bold"
				>
					{subtitle}
				</p>
			</header>
			<slot />
		</main>
		<nav
			aria-label="Screens"
			class="border-alt-light bg-body-light/90 dark:border-alt-dark dark:bg-body-dark/90 fixed inset-x-0 bottom-0 border-t backdrop-blur"
			style="padding-bottom: env(safe-area-inset-bottom)"
		>
			<div class="mx-auto flex max-w-md">
				{
					tabs.map((tab) => (
						<a
							href={tab.href}
							aria-current={isCurrent(tab.href) ? "page" : undefined}
							class="text-muted-light dark:text-muted-dark aria-[current=page]:text-primary flex-1 py-4 text-center text-xs font-extrabold tracking-widest uppercase"
						>
							{tab.label}
						</a>
					))
				}
			</div>
		</nav>
	</body>
</html>
