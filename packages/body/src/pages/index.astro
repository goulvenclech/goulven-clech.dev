---
import AppLayout from "$src/layouts/AppLayout.astro"
---

<AppLayout title="Today">
	<noscript>
		<p class="text-sm font-bold">
			This tracker needs JavaScript — the log lives in your browser.
		</p>
	</noscript>
	<div id="view"></div>
</AppLayout>

<script>
	import { renderToday } from "$src/client/today"

	renderToday(document.getElementById("view")!)
</script>
