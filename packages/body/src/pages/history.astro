---
import AppLayout from "$src/layouts/AppLayout.astro"
---

<AppLayout title="History" subtitle="Every set, newest first">
	<noscript>
		<p class="mt-8 text-sm font-bold">
			This tracker needs JavaScript — the log lives in your browser.
		</p>
	</noscript>
	<div id="view"></div>
</AppLayout>

<script>
	import { renderHistory } from "$src/client/history"

	renderHistory(document.getElementById("view")!)
</script>
