---
import AppLayout from "$src/layouts/AppLayout.astro"
---

<AppLayout title="Stats">
	<h1>Stats</h1>
	<noscript>
		<p class="mt-8 text-sm font-bold">
			This tracker needs JavaScript — the log lives in your browser.
		</p>
	</noscript>
	<div id="view"></div>
</AppLayout>

<script>
	import { renderStats } from "$src/client/stats"

	renderStats(document.getElementById("view")!)
</script>
