---
import AppLayout from "$src/layouts/AppLayout.astro"
---

<AppLayout
	title="Stats"
	subtitle="Adherence, wellness, weight, 1RM and tonnage"
	twin="/stats.md"
>
	<noscript>
		<p class="mt-8 text-sm font-bold">
			This tracker needs JavaScript — views render from your browser's copy of
			the log. Markdown version for crawlers, LLMs, and no-JS readers:
			<a href="/stats.md">/stats.md</a>.
		</p>
	</noscript>
	<div id="view"></div>
</AppLayout>

<script>
	import { renderStats } from "$src/client/stats"

	renderStats(document.getElementById("view")!)
</script>
