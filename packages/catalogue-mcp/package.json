{
	"name": "@goulven-clech/catalogue-mcp",
	"version": "0.1.0",
	"description": "Read-only MCP server over the goulven-clech.dev catalogue and to-do lists.",
	"type": "module",
	"private": true,
	"bin": {
		"catalogue-mcp": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.1"
	}
}
