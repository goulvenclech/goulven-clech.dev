---
import { formatCount, type EmotionTally } from "$src/catalogue/wrapped"
import "./chartFigure.css"

interface Props {
	emotions: EmotionTally[]
	caption: string
}

const { emotions, caption } = Astro.props

const maxCount = Math.max(...emotions.map((emotion) => emotion.count))

const rows = emotions.map((emotion) => ({
	label: `${emotion.emoji} ${emotion.name}`,
	count: emotion.count,
	widthPercent: (emotion.count / maxCount) * 100,
	title: `${emotion.name}: ${formatCount(emotion.count, "review", "reviews")}`,
}))
---

<figure class="top-emotions-chart" data-chart>
	<div class="chart-plot">
		{rows.map((row) => (
			<>
				<div class="row-label">{row.label}</div>
				<div class="row-bar">
					<div
						class="bar"
						style={`width:${row.widthPercent}%`}
						data-tooltip={row.title}
						title={row.title}
					/>
				</div>
				<div class="row-count">{row.count}</div>
			</>
		))}
	</div>

	<figcaption>{caption}</figcaption>

	<details class="chart-data">
		<summary>Show the numbers</summary>
		<div class="chart-data-scroll">
			<table>
				<thead>
					<tr>
						<th scope="col">Emotion</th>
						<th scope="col">Reviews</th>
					</tr>
				</thead>
				<tbody>
					{rows.map((row) => <tr>
						<th scope="row">{row.label}</th>
						<td>{row.count}</td>
					</tr>)}
				</tbody>
			</table>
		</div>
	</details>
</figure>

<style>
	@reference "$assets/base.css";

	.top-emotions-chart {
		@apply my-6 block;
	}

	.bar {
		@apply keep-colors bg-primary;
	}
</style>

<script>
	import { initChartTooltips } from "./chartTooltip"

	initChartTooltips()
</script>
