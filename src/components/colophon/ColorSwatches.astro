---
import Textures from "$components/images/Textures.astro"
import { isMarkerVariant, markerTag, textureIds } from "$src/markers"
import type { ThemeToken } from "$src/themeTokens"

interface Props {
	colors: ThemeToken[][]
	ramps?: { name: string; value?: string; colors: string[] }[]
}

const { colors, ramps = [] } = Astro.props

function textureOf(shades: ThemeToken[]): string | undefined {
	const name = shades[0]?.name ?? ""
	return isMarkerVariant(name) ? textureIds[name] : undefined
}

const swatches = [
	...colors.map((shades) => ({
		bands: shades.map(({ value }) => value),
		textureId: textureOf(shades),
		labels: shades,
	})),
	...ramps.map(({ colors, ...label }) => ({
		bands: colors,
		textureId: undefined,
		labels: [label],
	})),
]
---

<Textures />
<ul class="my-5 grid grid-cols-2 gap-5 sm:grid-cols-4">
	{swatches.map(({ bands, textureId, labels }) => <li class="min-w-0">
		<div
			class="border-font-light/15 dark:border-font-dark/15 flex h-12 border [print-color-adjust:exact]"
			aria-hidden="true"
		>
			{bands.map((band) => (
				<span
					class="grow forced-color-adjust-none"
					style={`background-color: ${band}`}
				/>
			))}
			{textureId && <svg class="h-full w-0 grow">
				<rect width="100%" height="100%" fill={`url(#${textureId})`} />
			</svg>}
		</div>
		{labels.map(({ name, value }) => {
			const Marker = isMarkerVariant(name) ? markerTag(name) : undefined
			return <Fragment>
				<strong class="mt-1 block">{Marker && <Marker />} {name}</strong>
				{value && <span
					class="block font-mono text-[12px] break-words sm:text-[14px]"
				>
					{value}
				</span>}
			</Fragment>
		})}
	</li>)}
</ul>
